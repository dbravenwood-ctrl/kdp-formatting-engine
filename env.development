:root {
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  color-scheme: light dark;
}

body {
  margin: 0;
  background: #0f1115;
  color: #e6e6e6;
}

.page {
  max-width: 720px;
  margin: 0 auto;
  padding: 2rem 1.25rem 4rem;
}

header h1 {
  font-size: 1.6rem;
  margin-bottom: 0.25rem;
}

.api-status {
  font-size: 0.85rem;
  color: #9aa0a6;
}

.ok {
  color: #4ade80;
  margin-left: 0.5rem;
}

.err {
  color: #f87171;
  margin-left: 0.5rem;
}

main {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-top: 1.5rem;
}

label {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  font-size: 0.9rem;
  color: #c7c7c7;
}

input,
textarea {
  background: #1a1d23;
  border: 1px solid #2c2f36;
  border-radius: 6px;
  padding: 0.6rem 0.75rem;
  color: #f0f0f0;
  font-size: 0.95rem;
  font-family: inherit;
}

textarea {
  resize: vertical;
  line-height: 1.5;
}

.actions {
  display: flex;
  gap: 0.75rem;
}

button {
  background: #4f46e5;
  color: white;
  border: none;
  border-radius: 6px;
  padding: 0.65rem 1.1rem;
  font-size: 0.95rem;
  cursor: pointer;
}

button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
